  "faq": {
    "title": "How Can We",
    "titleHighlight": "Help You?",
    "subtitle": "Search our knowledge base or browse categories to find answers to common questions about Void Loot services.",
    "searchPlaceholder": "Search for answers (e.g. 'refunds', 'shipping')...",
    "categoriesTitle": "Categories",
    "noResultsTitle": "No answers found",
    "noResultsDesc": "We couldn't find anything matching your search. Try different keywords.",
    "stillHaveQuestions": "Still have questions?",
    "stillHaveQuestionsDesc": "Can't find the answer you're looking for? Our tech drones and support team are available 24/7.",
    "openTicket": "Open Ticket",
    "liveChat": "Live Chat",
    "cats": {
      "all": "All Topics",
      "orders": "Orders & Shipping",
      "digital": "Digital Games & Keys",
      "cloud": "Void Cloud Services",
      "security": "Account & Security"
    },
    "q1": {
      "q": "How long does physical hardware shipping take?",
      "a": "Standard shipping across the globe takes 3-5 business days. Express Void Delivery guarantees arrival within 24-48 hours depending on your sector. Tracking codes are generated immediately after checkout."
    },
    "q2": {
      "q": "When do I receive my digital game key?",
      "a": "Instantly. Once your payment is verified by our secure gateway, the digital key is displayed on your screen and simultaneously sent to your registered email address and added to your Profile Dashboard."
    },
    "q3": {
      "q": "Can I refund a digital game if I don't like it?",
      "a": "Digital game keys cannot be refunded once they have been revealed or activated on Steam/PSN/Xbox. However, if you haven't viewed the key yet, you can request a refund within 14 days of purchase."
    },
    "q4": {
      "q": "What are the minimum internet requirements for Void Cloud?",
      "a": "For a smooth 1080p 60FPS experience, we recommend a stable 15Mbps connection. For 4K HDR gaming on our ultra-tier rigs, a minimum of 50Mbps is required. Ethernet is highly recommended over Wi-Fi."
    },
    "q5": {
      "q": "Do I need to buy games separately to play them on Cloud?",
      "a": "Yes and No. Void Cloud gives you access to a rotating library of 100+ free games. However, for specific AAA titles like Cyberpunk 2077 or Elden Ring, you must own the game on Steam, Epic, or through our store to stream it."
    },
    "q6": {
      "q": "How do I secure my account with Two-Factor Authentication (2FA)?",
      "a": "Navigate to Settings > Security & Login. Click on 'Enable 2FA' and scan the QR code using Google Authenticator, Authy, or any standard TOTP application."
    },
    "q7": {
      "q": "What payment methods do you accept?",
      "a": "We accept all major credit/debit cards, PayPal, Crypto (BTC, ETH, USDT), and Void Loot Wallet credits."
    }
  },
