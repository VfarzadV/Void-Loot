generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model OrderItems {
  OrderItemID Int      @id(map: "PK__OrderIte__57ED06A156A527FC") @default(autoincrement())
  OrderID     Int
  ProductID   Int
  Quantity    Int
  UnitPrice   Decimal  @db.Decimal(10, 2)
  Orders      Orders   @relation(fields: [OrderID], references: [OrderID], onUpdate: NoAction, map: "FK__OrderItem__Order__300424B4")
  Products    Products @relation(fields: [ProductID], references: [ProductID], onUpdate: NoAction, map: "FK__OrderItem__Produ__30F848ED")
}

model Orders {
  OrderID     Int          @id(map: "PK__Orders__C3905BAFB0E2A9EF") @default(autoincrement())
  UserID      Int
  TotalAmount Decimal      @db.Decimal(10, 2)
  Status      String?      @default("Processing", map: "DF__Orders__Status__2B3F6F97") @db.NVarChar(50)
  OrderDate   DateTime?    @default(now(), map: "DF__Orders__OrderDat__2C3393D0") @db.DateTime
  OrderItems  OrderItems[]
  Users       Users        @relation(fields: [UserID], references: [UserID], onUpdate: NoAction, map: "FK__Orders__UserID__2D27B809")
}

model Products {
  ProductID         Int                 @id(map: "PK__Products__B40CC6ED4E53D2A5") @default(autoincrement())
  Title             String              @db.NVarChar(150)
  Price             Decimal             @db.Decimal(10, 2)
  Stock             Int                 @default(0, map: "DF__Products__Stock__286302EC")
  Category          String?             @db.NVarChar(50)
  ImageUrl          String?             @db.NVarChar(255)
  BrandID           Int?
  Description       String?             @db.NVarChar(Max)
  HeroImage         String?             @db.NVarChar(Max)
  Metacritic        Int?
  ReleaseYear       String?             @db.NVarChar(10)
  Genre             String?             @db.NVarChar(100)
  OrderItems        OrderItems[]
  Brands            Brands?             @relation(fields: [BrandID], references: [BrandID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Products_Brands")
  UserCartItems     UserCartItems[]
  UserWishlistItems UserWishlistItems[]
  Promotions        Promotions[]
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B61974C8796") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
}

model Users {
  UserID             Int                  @id(map: "PK__Users__1788CCAC1A8E4050") @default(autoincrement())
  Username           String               @unique(map: "UQ_Users_Username") @db.NVarChar(50)
  Email              String               @unique(map: "UQ__Users__A9D105348ECBDF2E") @db.NVarChar(100)
  PasswordHash       String               @db.NVarChar(255)
  JoinDate           DateTime?            @default(now(), map: "DF__Users__JoinDate__25869641") @db.DateTime
  Orders             Orders[]
  Profile            UserProfiles?
  Sessions           UserSessions[]
  CartItems          UserCartItems[]
  WishlistItems      UserWishlistItems[]
  Notifications      Notifications[]
  SupportTickets     SupportTickets[]
  CommunityPosts     CommunityPosts[]
  CommunityComments  CommunityComments[]
  CommunityPostLikes CommunityPostLikes[]
  LootBoxClaims      LootBoxClaims[]
}

model Brands {
  BrandID  Int        @id(map: "PK__Brands__DAD4F3BE09F14FCB") @default(autoincrement())
  Name     String     @db.NVarChar(100)
  Slug     String     @unique(map: "UQ__Brands__BC7B5FB65AEB54A8") @db.NVarChar(100)
  ImageUrl String?    @db.NVarChar(500)
  Products Products[]
}

model UserProfiles {
  UserID      Int     @id
  DisplayName String? @db.NVarChar(100)
  AvatarUrl   String? @db.NVarChar(1000)
  BannerUrl   String? @db.NVarChar(1000)
  Level       Int     @default(1)
  Users       Users   @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction)
}

model UserSessions {
  SessionID String   @id @db.NVarChar(64)
  UserID    Int
  ExpiresAt DateTime @db.DateTime2
  CreatedAt DateTime @default(now()) @db.DateTime2
  Users     Users    @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction)

  @@index([UserID])
  @@index([ExpiresAt])
}

model UserCartItems {
  UserID    Int
  ProductID Int
  Quantity  Int      @default(1)
  AddedAt   DateTime @default(now()) @db.DateTime2
  Users     Users    @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction)
  Products  Products @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade, onUpdate: NoAction)

  @@id([UserID, ProductID])
  @@index([ProductID])
}

model UserWishlistItems {
  UserID    Int
  ProductID Int
  AddedAt   DateTime @default(now()) @db.DateTime2
  Users     Users    @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction)
  Products  Products @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade, onUpdate: NoAction)

  @@id([UserID, ProductID])
  @@index([ProductID])
}

model Notifications {
  NotificationID Int      @id @default(autoincrement())
  UserID         Int
  EventKey       String   @db.NVarChar(200)
  Type           String   @db.NVarChar(50)
  ReferenceID    Int?
  Details        String?  @db.NVarChar(300)
  IsRead         Boolean  @default(false)
  CreatedAt      DateTime @default(now()) @db.DateTime2
  Users          Users    @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction)

  @@unique([UserID, EventKey])
  @@index([UserID, CreatedAt])
}

model SupportTickets {
  TicketID  Int      @id @default(autoincrement())
  UserID    Int
  Subject   String   @db.NVarChar(200)
  Category  String   @db.NVarChar(50)
  Message   String   @db.NVarChar(Max)
  Status    String   @default("Open") @db.NVarChar(30)
  CreatedAt DateTime @default(now()) @db.DateTime2
  Users     Users    @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction)

  @@index([UserID, CreatedAt])
}

model Promotions {
  PromotionID        Int      @id @default(autoincrement())
  ProductID          Int
  Title              String?  @db.NVarChar(200)
  DiscountPercentage Decimal  @db.Decimal(5, 2)
  StartsAt           DateTime @db.DateTime2
  EndsAt             DateTime @db.DateTime2
  IsActive           Boolean  @default(true)
  Products           Products @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade, onUpdate: NoAction)

  @@index([ProductID])
  @@index([IsActive, StartsAt, EndsAt])
}

model CommunityPosts {
  PostID    Int                  @id @default(autoincrement())
  UserID    Int
  Title     String               @db.NVarChar(200)
  Content   String               @db.NVarChar(Max)
  Category  String               @db.NVarChar(50)
  Tags      String               @default("[]") @db.NVarChar(Max)
  CreatedAt DateTime             @default(now()) @db.DateTime2
  Users     Users                @relation(fields: [UserID], references: [UserID], onUpdate: NoAction)
  Comments  CommunityComments[]
  Likes     CommunityPostLikes[]

  @@index([CreatedAt])
}

model CommunityComments {
  CommentID Int            @id @default(autoincrement())
  PostID    Int
  UserID    Int
  Content   String         @db.NVarChar(Max)
  CreatedAt DateTime       @default(now()) @db.DateTime2
  Posts     CommunityPosts @relation(fields: [PostID], references: [PostID], onDelete: Cascade, onUpdate: NoAction)
  Users     Users          @relation(fields: [UserID], references: [UserID], onUpdate: NoAction)

  @@index([PostID, CreatedAt])
}

model CommunityPostLikes {
  PostID    Int
  UserID    Int
  CreatedAt DateTime       @default(now()) @db.DateTime2
  Posts     CommunityPosts @relation(fields: [PostID], references: [PostID], onDelete: Cascade, onUpdate: NoAction)
  Users     Users          @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction)

  @@id([PostID, UserID])
  @@index([UserID])
}

model LootBoxClaims {
  ClaimID   Int      @id(map: "PK_LootBoxClaims") @default(autoincrement())
  UserID    Int
  RewardKey String   @db.NVarChar(50)
  DrawDate  DateTime @db.Date
  CreatedAt DateTime @default(now()) @db.DateTime2
  Users     Users    @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "FK_LootBoxClaims_Users")

  @@unique([UserID, DrawDate], map: "UQ_LootBoxClaims_UserID_DrawDate")
  @@index([UserID, CreatedAt], map: "IX_LootBoxClaims_UserID_CreatedAt")
}
